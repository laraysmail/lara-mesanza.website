---
const navLinks = [
  { href: '/tienda', label: 'Tienda' },
  { href: '/descuentos', label: 'Descuentos' },
  { href: '/asesoramiento', label: 'Asesoramiento' },
  { href: '/#videos-section', label: 'Vídeos' },
];
---

<header>
  <a class="logo" href="/">LARA MESANZA</a>
  <nav>
    {navLinks.map(link => <a href={link.href}>{link.label}</a>)}
    <a href="/contacto" class="cta">Contacto</a>
  </nav>
</header>

<style>
  header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 200;
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px 32px; mix-blend-mode: difference;
  }
  .logo { font-family: var(--display); font-weight: 700; font-size: 1.15rem; color: #fff; }
  nav {
    display: flex; gap: 6px; background: rgba(255,255,255,0.08);
    backdrop-filter: blur(14px); padding: 6px; border-radius: 100px;
    border: 1px solid rgba(255,255,255,0.2);
  }
  nav a {
    font-family: var(--display); font-weight: 500; font-size: 13px;
    color: #fff; opacity: .85; padding: 9px 18px; border-radius: 100px;
    transition: all .25s ease;
  }
  nav a:hover { opacity: 1; background: rgba(255,255,255,0.12); }
  @media (max-width: 760px) { nav a:not(.cta) { display: none; } }
</style>
