---
import { Image } from 'astro:assets';
import diyPhoto from '../assets/site/path-diy-painting.webp';
import viajePhoto from '../assets/site/path-viaje-hitchhiking.jpg';
---

<section class="paths">
  <div class="wrap reveal">
    <div class="paths-head">
      <span class="kicker">// por dónde empiezo</span>
      <h2>¿Qué te trae por aquí?</h2>
    </div>
    <div class="paths-grid">
      <a href="/tienda" class="path-card tilt-card">
        <Image src={diyPhoto} alt="Lara Mesanza pintando el interior de una furgoneta camperizada" class="path-photo" widths={[400, 600, 900]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" />
        <div class="path-card-tint"></div>
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 15l2-6a2 2 0 012-1.4h10A2 2 0 0119 9l2 6"/><rect x="2" y="15" width="20" height="5" rx="1.5"/><circle cx="7" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg></div>
        <div>
          <h3>Tengo un proyecto DIY</h3>
          <p>Diagramas, plantillas, productos y descuentos para tu furgo, camión, piso o terreno.</p>
        </div>
        <span class="link">Ver todo →</span>
      </a>
      <a href="/descuentos" class="path-card tilt-card">
        <Image src={viajePhoto} alt="Lara Mesanza haciendo autostop en una carretera durante un viaje" class="path-photo" widths={[400, 600, 900]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" />
        <div class="path-card-tint"></div>
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg></div>
        <div>
          <h3>Quiero viajar más barato</h3>
          <p>Descuentos reales de nuestras colabs, más los productos que llevamos siempre encima.</p>
        </div>
        <span class="link">Ver descuentos →</span>
      </a>
    </div>
  </div>
</section>

<style>
  .paths { padding: 110px 0 100px; }
  .paths-head { max-width: 600px; }
  .paths-grid { margin-top: 56px; display: grid; grid-template-columns: repeat(2,1fr); gap: 22px; }
  @media (max-width: 900px) { .paths-grid { grid-template-columns: 1fr; } }
  .path-card {
    display: flex; position: relative; overflow: hidden; color: var(--cream); border-radius: 22px; padding: 34px 28px;
    flex-direction: column; justify-content: space-between; min-height: 260px;
    transition: transform .35s cubic-bezier(.16,1,.3,1);
  }
  .path-card:hover { transform: translateY(-8px); }
  .path-card .path-photo {
    position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform .5s ease;
  }
  .path-card:hover .path-photo { transform: scale(1.05); }
  .path-card .path-card-tint {
    position: absolute; inset: 0; z-index: 1; background: linear-gradient(200deg, rgba(16,25,21,0.4) 0%, var(--forest) 82%);
  }
  .path-card:nth-child(2) .path-card-tint { background: linear-gradient(200deg, rgba(16,25,21,0.4) 0%, var(--moss) 82%); }
  .path-card .icon { position: relative; z-index: 2; width: 30px; height: 30px; color: var(--pop); margin-bottom: auto; }
  .path-card .icon svg { width: 100%; height: 100%; }
  .path-card h3 { position: relative; z-index: 2; font-family: var(--display); font-weight: 700; font-size: 1.7rem; margin: 22px 0 10px; }
  .path-card p { position: relative; z-index: 2; color: var(--mist); font-size: .96rem; opacity: .9; line-height: 1.5; }
  .path-card .link {
    position: relative; z-index: 2;
    margin-top: 20px; display: inline-flex; align-items: center; gap: 6px; font-family: var(--display);
    font-weight: 600; font-size: 15px; letter-spacing: .02em; color: var(--pop);
  }
</style>
