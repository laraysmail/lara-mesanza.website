---
import site from '../data/site.json';
const { subscribers, countries, diyProjects, currentLocation } = site.stats;
---

<section class="trust">
  <div class="wrap trust-row">
    <div class="trust-item" style="--d:0s">
      <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l6 3-6 3V9z" fill="currentColor" stroke="none"/></svg></div>
      <b class="count" data-target={subscribers.value} data-suffix={subscribers.suffix}>0</b>
      <span>{subscribers.label}</span>
    </div>
    <div class="trust-item" style="--d:.08s">
      <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 6 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-6-3.8-9s1.3-6.5 3.8-9z"/></svg></div>
      <b class="count" data-target={countries.value} data-prefix={countries.prefix}>0</b>
      <span>{countries.label}</span>
    </div>
    <div class="trust-item" style="--d:.16s">
      <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.5 3.5l6 6L9 21l-6.5 1.5L4 16l10.5-12.5z"/><path d="M13 5l6 6"/></svg></div>
      <b class="count" data-target={diyProjects.value}>0</b>
      <span>{diyProjects.label}<span class="sub">{diyProjects.sub}</span></span>
    </div>
    <div class="trust-item" style="--d:.24s">
      <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.3"/></svg></div>
      <b class="pop">{currentLocation.value}</b>
      <span>{currentLocation.label}<span class="sub">{currentLocation.sub}</span></span>
    </div>
  </div>
</section>

<style>
  .trust { background: var(--forest); padding: 56px 0; }
  .trust-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; }
  @media (max-width: 760px) { .trust-row { grid-template-columns: repeat(2,1fr); row-gap: 36px; } }
  .trust-item {
    display: flex; flex-direction: column; gap: 8px; text-align: center; padding: 0 18px;
    border-left: 1px solid rgba(243,239,228,0.12);
    opacity: 0; transform: translateY(16px); transition: opacity .6s ease var(--d,0s), transform .6s ease var(--d,0s);
  }
  .trust-item:first-child { border-left: none; }
  @media (max-width: 760px) { .trust-item:nth-child(odd) { border-left: none; } }
  .trust-item.is-visible { opacity: 1; transform: translateY(0); }
  .trust-item .icon { width: 26px; height: 26px; margin: 0 auto; color: var(--pop); }
  .trust-item .icon svg { width: 100%; height: 100%; }
  .trust-item b {
    font-family: var(--display); font-weight: 700; font-size: clamp(1.7rem,3.4vw,2.4rem); color: var(--cream);
    letter-spacing: -.01em; line-height: 1; font-variant-numeric: tabular-nums;
  }
  .trust-item b.pop { color: var(--pop); }
  .trust-item span {
    font-family: var(--mono); font-size: 11px; letter-spacing: .03em; color: var(--sage);
    line-height: 1.4; max-width: 190px; margin: 0 auto;
  }
  .trust-item span.sub { display: block; opacity: .55; font-size: 10px; margin-top: 2px; }
</style>
