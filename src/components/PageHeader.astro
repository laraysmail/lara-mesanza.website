---
interface Props {
  kicker: string;
  description?: string;
}
const { kicker, description } = Astro.props;
---

<section class="epic-header">
  <div class="grid-clip"><div class="grid-bg"></div></div>
  <div class="glow" id="epicGlow1"></div>
  <div class="glow two" id="epicGlow2"></div>
  <div class="epic-header-content">
    <span class="kicker">{kicker}</span>
    <h1><slot name="title" /></h1>
    {description && <p>{description}</p>}
    <div class="epic-header-extra"><slot /></div>
  </div>
</section>

<style>
  .epic-header {
    position: relative; height: 40vh; min-height: 320px; overflow: visible;
    background: linear-gradient(160deg, var(--forest) 0%, var(--pine) 75%);
    display: flex; align-items: center; justify-content: center;
  }
  .grid-clip { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
  .epic-header .grid-bg {
    position: absolute; inset: -10%;
    background-image: linear-gradient(rgba(243,239,228,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(243,239,228,0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(circle at 50% 45%, black 0%, transparent 72%);
  }
  /* not clipped to the header — lets the glow bleed softly into the section below
     instead of cutting off dead at the edge, so the motion doesn't just stop */
  .epic-header .glow {
    position: absolute; width: 480px; height: 480px; border-radius: 50%; z-index: 0; pointer-events: none;
    background: radial-gradient(circle, rgba(193,96,47,0.32), transparent 68%);
    top: -10%; right: -8%; will-change: transform;
  }
  .epic-header .glow.two {
    left: -10%; bottom: -35%; top: auto; right: auto; width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(60,92,77,0.48), transparent 68%);
  }
  .epic-header-content {
    position: relative; z-index: 1; text-align: center; padding: 0 32px; max-width: 680px;
    opacity: 0; transform: translateY(28px);
    animation: header-in .9s cubic-bezier(.16,1,.3,1) .1s forwards;
  }
  @keyframes header-in { to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .epic-header-content { animation: none; opacity: 1; transform: none; } }
  .epic-header .kicker {
    font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--pop); display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 16px;
  }
  .epic-header .kicker::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--pop); box-shadow: 0 0 10px var(--pop); }
  .epic-header h1 {
    font-family: var(--display); font-weight: 800; letter-spacing: -.03em; line-height: 1;
    font-size: clamp(2rem, 4.6vw, 3.6rem); color: var(--cream); text-wrap: balance;
  }
  .epic-header h1 :global(span) { color: var(--pop); }
  .epic-header p { margin: 16px auto 0; max-width: 440px; color: var(--mist); font-size: .98rem; line-height: 1.55; }
  .epic-header-extra:empty { display: none; }
  .epic-header-extra { margin-top: 18px; display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; }
  /* re-theme FilterPills for the dark header background it sits on here */
  .epic-header-extra :global(.filter-pills) { margin-top: 0; justify-content: center; }
  .epic-header-extra :global(.filter-pill) { border-color: rgba(243,239,228,0.25); color: var(--cream); }
  .epic-header-extra :global(.filter-pill.active) { background: var(--pop); border-color: var(--pop); color: var(--pine); }
  @media (max-width: 760px) { .epic-header .glow { display: none; } }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.epic-header').forEach((header) => {
    const glow1 = header.querySelector('#epicGlow1');
    const glow2 = header.querySelector('#epicGlow2');
    if (prefersReduced || !glow1 || !glow2) return;
    const onScroll = () => {
      const r = header.getBoundingClientRect();
      const p = r.top;
      glow1.style.transform = `translateY(${p * -0.18}px)`;
      glow2.style.transform = `translateY(${p * -0.1}px)`;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>
