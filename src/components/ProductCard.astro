---
import { Image } from 'astro:assets';

interface Props {
  source: string;
  name: string;
  price: string | null;
  url: string;
  categories: string[];
  image?: ImageMetadata | string | null;
  x?: string;
  d?: string;
  href?: string;
  discount?: string;
}
const { source, name, price, url, categories, image = null, x = '50px', d = '0s', href, discount } = Astro.props;
const linkHref = href ?? url;
const isExternal = linkHref.startsWith('http');
---

<a
  href={linkHref}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="p-small tilt-card slide-in"
  data-category={categories.join(' ')}
  style={`--x:${x}; --d:${d}`}
>
  <div class="p-small-visual">
    {discount && <span class="discount-chip">{discount}</span>}
    {image && typeof image !== 'string' && (
      <Image src={image} alt={name} widths={[300, 500]} sizes="(max-width: 900px) 50vw, 33vw" format="webp" quality={75} loading="lazy" />
    )}
    {image && typeof image === 'string' && (
      <img src={image} alt={name} loading="lazy" decoding="async" width="400" height="300" />
    )}
    {!image && <div class="p-small-visual-fallback"></div>}
  </div>
  <div class="p-small-body">
    <span class="tag">{source}</span>
    <h4>{name}</h4>
    {price && <div class="price">{price}</div>}
  </div>
</a>

<style>
  .p-small {
    display: flex; border-radius: 20px; overflow: hidden; background: var(--forest); color: var(--cream);
    flex-direction: column; min-height: 245px;
    transition: transform .4s cubic-bezier(.16,1,.3,1);
  }
  .p-small:hover { transform: translateY(-6px); }
  .discount-chip {
    position: absolute; top: 12px; left: 12px; z-index: 2; font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: .04em;
    background: var(--pop); color: var(--pine); padding: 6px 10px; border-radius: 100px; font-weight: 600;
  }
  .p-small-visual { position: relative; aspect-ratio: 4/3; background: rgba(243,239,228,0.06); overflow: hidden; }
  .p-small-visual img { width: 100%; height: 100%; object-fit: cover; }
  .p-small-visual-fallback { width: 100%; height: 100%; background: radial-gradient(circle at 75% 20%, rgba(193,96,47,0.22), transparent 55%), linear-gradient(150deg, var(--moss), var(--pine)); }
  .p-small-body { display: flex; flex-direction: column; justify-content: space-between; flex: 1; padding: 18px 22px 22px; }
  .p-small .tag { font-family: var(--mono); font-size: 10px; text-transform: uppercase; color: var(--sage); }
  .p-small h4 { font-family: var(--display); font-weight: 600; font-size: 1.15rem; margin-top: auto; padding-top: 14px; }
  .p-small .price { font-family: var(--mono); font-size: .85rem; color: var(--sage); margin-top: 6px; }
</style>
