---
interface Props {
  source: string;
  name: string;
  price: string;
  url: string;
  categories: string[];
  x?: string;
  d?: string;
}
const { source, name, price, url, categories, x = '50px', d = '0s' } = Astro.props;
---

<a
  href={url}
  target={url === '#' ? undefined : '_blank'}
  rel={url === '#' ? undefined : 'noopener noreferrer'}
  class="p-small tilt-card slide-in"
  data-category={categories.join(' ')}
  style={`--x:${x}; --d:${d}`}
>
  <span class="tag">{source}</span>
  <h4>{name}</h4>
  <div class="price">{price}</div>
</a>

<style>
  .p-small {
    display: flex; border-radius: 20px; overflow: hidden; background: var(--forest); color: var(--cream); padding: 22px;
    flex-direction: column; justify-content: space-between; min-height: 245px;
    transition: transform .4s cubic-bezier(.16,1,.3,1);
  }
  .p-small:hover { transform: translateY(-6px); }
  .p-small .tag { font-family: var(--mono); font-size: 10px; text-transform: uppercase; color: var(--sage); }
  .p-small h4 { font-family: var(--display); font-weight: 600; font-size: 1.05rem; margin-top: auto; padding-top: 14px; }
  .p-small .price { font-family: var(--mono); font-size: .85rem; color: var(--sage); margin-top: 6px; }
</style>
