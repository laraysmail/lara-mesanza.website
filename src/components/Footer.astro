---
const year = new Date().getFullYear();
const youtubeUrl = '#';
const navLinks = [
  { href: '/tienda', label: 'Tienda' },
  { href: '/descuentos', label: 'Descuentos' },
  { href: '/asesoramiento', label: 'Asesoramiento' },
  { href: '/contacto', label: 'Contacto' },
  { href: '/#videos-section', label: 'Vídeos' },
];
---

<footer>
  <div class="footer-grid-bg"></div>
  <div class="footer-blob" id="footerBlob"></div>
  <div class="wrap">
    <span class="kicker">// sigue la aventura</span>
    <h3 class="footer-huge">¿Nos vemos<br>en el <span>próximo vídeo</span>?</h3>

    <div class="footer-subscribe">
      <a href={youtubeUrl} class="subscribe-btn" target={youtubeUrl === '#' ? undefined : '_blank'} rel={youtubeUrl === '#' ? undefined : 'noopener noreferrer'}>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-1.5-.15-2.6-.5-3.5a3 3 0 00-2.1-2.1C18 6 12 6 12 6s-6 0-7.4.4A3 3 0 002.5 8.5C2.15 9.4 2 10.5 2 12s.15 2.6.5 3.5a3 3 0 002.1 2.1C6 18 12 18 12 18s6 0 7.4-.4a3 3 0 002.1-2.1c.35-.9.5-2 .5-3.5z"/><path d="M10 9.5l5 2.5-5 2.5v-5z" fill="var(--pine)"/></svg>
        Suscríbete en YouTube →
      </a>
    </div>

    <div class="footer-marquee">
      <div class="footer-marquee-track">
        {[0, 1].map(() => navLinks.map((link) => (
          <>
            <a href={link.href}>{link.label}</a><span class="dot">●</span>
          </>
        )))}
      </div>
    </div>

    <div class="footer-bottom-row">
      <div class="footer-social">
        <a href={youtubeUrl} class="tilt-card" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-1.5-.15-2.6-.5-3.5a3 3 0 00-2.1-2.1C18 6 12 6 12 6s-6 0-7.4.4A3 3 0 002.5 8.5C2.15 9.4 2 10.5 2 12s.15 2.6.5 3.5a3 3 0 002.1 2.1C6 18 12 18 12 18s6 0 7.4-.4a3 3 0 002.1-2.1c.35-.9.5-2 .5-3.5z"/><path d="M10 9.5l5 2.5-5 2.5v-5z" fill="var(--pine)"/></svg></a>
        <a href="#" class="tilt-card" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
        <a href="#" class="tilt-card" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2 1.7 3.4 4 3.6v3c-1.5 0-2.8-.4-4-1.2v6.4a5.8 5.8 0 11-5-5.7v3.1a2.7 2.7 0 102.2 2.6V3h2.8z"/></svg></a>
        <a href="mailto:lara.mesanza@gmail.com" class="tilt-card" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6l8.5 7 8.5-7"/></svg></a>
      </div>
      <div class="footer-meta">© {year} Lara Mesanza · laramesanza.com</div>
      <button class="back-to-top" id="backToTop" aria-label="Volver arriba"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--pine); color: var(--mist); padding: 120px 0 0; position: relative; overflow: hidden; }
  .footer-grid-bg {
    position: absolute; inset: 0; z-index: 0;
    background-image: linear-gradient(rgba(243,239,228,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(243,239,228,0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(circle at 30% 20%, black 0%, transparent 65%);
  }
  .footer-blob {
    position: absolute; top: -20%; right: -10%; width: 520px; height: 520px; border-radius: 50%;
    background: radial-gradient(circle, rgba(193,96,47,0.12), transparent 70%); z-index: 0; pointer-events: none;
  }
  footer .wrap { position: relative; z-index: 1; }

  .footer-huge {
    font-family: var(--display); font-weight: 700; letter-spacing: -.03em;
    font-size: clamp(2.6rem, 8vw, 6.5rem); color: var(--cream); line-height: .98; max-width: 900px;
  }
  .footer-huge span { color: var(--pop); }

  .footer-subscribe { margin-top: 28px; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .subscribe-btn {
    display: inline-flex; align-items: center; gap: 10px; background: var(--pop); color: var(--pine);
    font-family: var(--display); font-weight: 600; font-size: 14px; padding: 12px 22px; border-radius: 100px;
    transition: background .25s ease, transform .25s ease;
  }
  .subscribe-btn svg { width: 18px; height: 18px; flex-shrink: 0; }
  .subscribe-btn:hover { background: #d97442; transform: translateY(-2px); }

  .footer-marquee {
    margin-top: 64px; border-top: 1px solid rgba(243,239,228,0.14); border-bottom: 1px solid rgba(243,239,228,0.14);
    overflow: hidden; white-space: nowrap; padding: 22px 0;
  }
  .footer-marquee-track { display: inline-flex; gap: 0; animation: footer-scroll 22s linear infinite; }
  .footer-marquee-track a {
    font-family: var(--display); font-weight: 600; font-size: clamp(1.3rem,3vw,2rem); color: var(--cream); opacity: .55;
    padding: 0 34px; transition: opacity .25s ease, color .25s ease; letter-spacing: -.01em;
  }
  .footer-marquee-track a:hover { opacity: 1; color: var(--pop); }
  .footer-marquee-track span.dot { color: var(--pop); opacity: .7; font-size: 1.2rem; }
  @keyframes footer-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .footer-marquee-track { animation: none; } }

  .footer-bottom-row {
    margin-top: 44px; padding: 32px 0 40px; display: flex; align-items: center; justify-content: space-between;
    gap: 24px; flex-wrap: wrap;
  }
  .footer-social { display: flex; gap: 12px; }
  .footer-social a {
    width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(243,239,228,0.2);
    display: flex; align-items: center; justify-content: center; transition: border-color .25s ease, background .25s ease;
  }
  .footer-social a:hover { border-color: var(--pop); background: rgba(193,96,47,0.12); }
  .footer-social a svg { width: 18px; height: 18px; color: var(--cream); }
  .footer-meta { font-family: var(--mono); font-size: .74rem; opacity: .45; letter-spacing: .02em; }
  .back-to-top {
    width: 48px; height: 48px; border-radius: 50%; background: var(--pop); color: var(--pine);
    display: flex; align-items: center; justify-content: center; border: none; cursor: pointer;
    transition: transform .3s cubic-bezier(.16,1,.3,1), background .25s ease;
  }
  .back-to-top:hover { transform: translateY(-4px); background: #d97442; }
  .back-to-top svg { width: 18px; height: 18px; }
  @media (max-width: 640px) { .footer-bottom-row { justify-content: center; text-align: center; } }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const footerBlob = document.getElementById('footerBlob');
  if (footerBlob && !prefersReduced) {
    const footerEl = document.querySelector('footer');
    const onScroll = () => {
      const fr = footerEl.getBoundingClientRect();
      footerBlob.style.transform = `translateY(${fr.top * -0.08}px)`;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  const backToTop = document.getElementById('backToTop');
  if (backToTop) {
    backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' }));
  }
</script>
