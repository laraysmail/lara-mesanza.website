---
import VideoCard from './VideoCard.astro';

interface Video { category: string; title: string; url: string; thumbnail?: string | null; }
interface Props { videos: Video[]; viewAllHref?: string; }
const { videos, viewAllHref } = Astro.props;
const xDirs = ['-40px', '40px', '-40px'];
---

<section class="videos" id="videos-section">
  <div class="wrap reveal">
    <div class="videos-head">
      <div><span class="kicker">// consejos buenos, bonitos y baratos</span><h2>Últimos vídeos</h2></div>
      <p>Lo último del canal: camperización, reformas y ahora, rumbo a Asia. <a class="see-all" href={viewAllHref}>Ver todos los vídeos →</a></p>
    </div>
    <div class="video-grid">
      {videos.map((v, i) => (
        <VideoCard category={v.category} title={v.title} url={v.url} thumbnail={v.thumbnail} x={xDirs[i % 3]} d={`${(i % 3) * 0.1}s`} />
      ))}
    </div>
  </div>
</section>

<style>
  .videos { padding: 110px 0; background: var(--cream); }
  .videos-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .videos-head p { max-width: 380px; opacity: .65; font-size: .95rem; line-height: 1.5; }
  .videos-head .see-all { display: inline-block; margin-top: 6px; opacity: 1; color: var(--popd); font-family: var(--display); font-weight: 600; font-size: .85rem; }
  .video-grid { margin-top: 56px; display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; }
  @media (max-width: 900px) { .video-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 600px) { .video-grid { grid-template-columns: 1fr; } }
</style>
