---
import allDiscounts from '../data/discounts.json';
import DiscountCard from './DiscountCard.astro';
import FilterPills from './FilterPills.astro';

interface Props {
  limit?: number;
  viewAllHref?: string;
}
const { limit, viewAllHref } = Astro.props;

const discounts = limit ? allDiscounts.slice(0, limit) : allDiscounts;
const hasMore = limit ? allDiscounts.length > limit : false;

const columns = [[], [], []];
discounts.forEach((d, i) => columns[i % 3].push(d));
const speeds = [0.05, -0.08, 0.1];
const xDirs = ['-40px', '40px', '-40px'];
---

<section class="discounts" id="descuentos">
  <div class="float-blob" id="discountsBlob" style="width:380px; height:380px; bottom:-15%; left:-10%; background:radial-gradient(circle, rgba(60,92,77,0.18), transparent 70%);"></div>
  <div class="wrap reveal">
    <span class="kicker">// ahorra de verdad</span>
    <h2>Descuentos que uso yo misma</h2>
    <FilterPills targetId="discountCols" options={[{ value: 'todo', label: 'Todo' }, { value: 'camper', label: 'Camper' }, { value: 'viaje', label: 'Viaje' }, { value: 'vida', label: 'Vida' }]} />
    <div class="discount-cols" id="discountCols">
      {columns.map((col, ci) => (
        <div class="discount-col" data-speed={speeds[ci]}>
          {col.map((d, di) => (
            <DiscountCard
              name={d.name}
              description={d.description}
              category={d.category}
              discountType={d.discountType}
              value={d.value}
              code={d.code}
              url={d.url}
              logo={d.logo}
              x={xDirs[ci]}
              d={`${di * 0.05}s`}
            />
          ))}
        </div>
      ))}
    </div>
    {hasMore && viewAllHref && (
      <div class="view-all"><a href={viewAllHref}>Ver todos los descuentos →</a></div>
    )}
    <div class="email-feature">
      <div class="email-feature-bg"></div>
      <div class="glow-ring"></div>
      <div class="spark" style="left:12%; animation-delay:0s;"></div>
      <div class="spark" style="left:30%; animation-delay:.8s;"></div>
      <div class="spark" style="left:55%; animation-delay:1.6s;"></div>
      <div class="spark" style="left:75%; animation-delay:.4s;"></div>
      <div class="spark" style="left:90%; animation-delay:1.2s;"></div>
      <div class="email-feature-inner">
        <div class="email-feature-text">
          <div class="bell-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 00-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          </div>
          <h3>No te pierdas el próximo código</h3>
          <p>Te aviso en cuanto consigo un descuento nuevo, directo a tu correo.</p>
        </div>
        <form class="email-feature-form" onsubmit="return false;">
          <input type="email" placeholder="tu@email.com" required />
          <button type="submit">
            <span>Avisarme</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .discounts { padding: 100px 0 140px; }
  .discount-cols { margin-top: 44px; display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; align-items: start; }
  @media (max-width: 860px) { .discount-cols { grid-template-columns: 1fr; gap: 16px; } }
  .discount-col { display: flex; flex-direction: column; gap: 20px; will-change: transform; }
  .view-all { margin-top: 32px; text-align: center; }
  .view-all a {
    font-family: var(--display); font-weight: 600; font-size: 14px; color: var(--popd);
    display: inline-flex; align-items: center; gap: 6px;
  }
  .email-feature {
    margin-top: 50px; position: relative; overflow: hidden; background: var(--pop); color: var(--pine);
    border-radius: 24px; padding: 48px 40px;
  }
  .email-feature-bg {
    position: absolute; inset: 0; z-index: 0; opacity: .5;
    background-image: linear-gradient(rgba(16,25,21,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(16,25,21,0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(circle at 85% 20%, black 0%, transparent 60%);
  }
  .glow-ring {
    position: absolute; top: 50%; right: -10%; width: 420px; height: 420px; border-radius: 50%; z-index: 0;
    background: radial-gradient(circle, rgba(16,25,21,0.16), transparent 68%);
    transform: translateY(-50%); animation: glow-breathe 4s ease-in-out infinite;
  }
  @keyframes glow-breathe { 0%, 100% { opacity: .6; transform: translateY(-50%) scale(1); } 50% { opacity: 1; transform: translateY(-50%) scale(1.12); } }

  .spark {
    position: absolute; bottom: 14%; width: 5px; height: 5px; border-radius: 50%;
    background: var(--pine); opacity: 0; z-index: 0; animation: spark-rise 3.4s ease-in infinite;
  }
  @keyframes spark-rise {
    0% { opacity: 0; transform: translateY(0) scale(.6); }
    12% { opacity: .55; }
    85% { opacity: .2; }
    100% { opacity: 0; transform: translateY(-160px) scale(1); }
  }

  .email-feature-inner { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .email-feature-text { max-width: 460px; }

  .bell-badge {
    width: 56px; height: 56px; border-radius: 50%; background: rgba(16,25,21,0.1);
    border: 1.5px solid rgba(16,25,21,0.25); display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px; position: relative;
  }
  .bell-badge svg { width: 24px; height: 24px; transform-origin: 50% 15%; animation: bell-ring 3.2s ease-in-out infinite; }
  @keyframes bell-ring {
    0%, 72%, 100% { transform: rotate(0deg); }
    74% { transform: rotate(14deg); } 76% { transform: rotate(-12deg); } 78% { transform: rotate(9deg); }
    80% { transform: rotate(-6deg); } 82% { transform: rotate(3deg); } 84% { transform: rotate(0deg); }
  }
  .bell-badge::after, .bell-badge::before {
    content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 1.5px solid rgba(16,25,21,0.28);
    animation: bell-ping 3.2s cubic-bezier(.4,0,.6,1) infinite;
  }
  .bell-badge::before { animation-delay: 1s; }
  @keyframes bell-ping { 0% { transform: scale(.9); opacity: .8; } 80%, 100% { transform: scale(1.5); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .bell-badge::after, .bell-badge::before, .bell-badge svg, .glow-ring, .spark { animation: none; }
  }

  .email-feature-text h3 {
    font-family: var(--display); font-weight: 800; letter-spacing: -.02em;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem); line-height: 1.08; text-wrap: balance;
  }
  .email-feature-text p { margin-top: 14px; font-size: .98rem; line-height: 1.55; opacity: .82; max-width: 380px; }

  .email-feature-form { display: flex; gap: 10px; min-width: 300px; flex-wrap: wrap; }
  .email-feature-form input {
    flex: 1; background: var(--cream); border: 2px solid transparent; border-radius: 100px;
    padding: 15px 20px; color: var(--pine); font-family: var(--body); font-size: .95rem; min-width: 200px;
    transition: box-shadow .25s ease; position: relative; z-index: 1;
  }
  .email-feature-form input:focus { outline: none; border-color: var(--pine); box-shadow: 0 0 0 4px rgba(16,25,21,0.12); }
  .email-feature-form button {
    background: var(--pine); color: var(--cream); border: none; border-radius: 100px; padding: 15px 24px;
    font-family: var(--display); font-weight: 700; font-size: .95rem; cursor: pointer; white-space: nowrap;
    display: inline-flex; align-items: center; gap: 8px; position: relative; z-index: 1;
    transition: transform .25s cubic-bezier(.16,1,.3,1), background .25s ease;
  }
  .email-feature-form button svg { width: 16px; height: 16px; transition: transform .25s ease; }
  .email-feature-form button:hover { transform: translateY(-3px); background: var(--forest); color: var(--cream); }
  .email-feature-form button:hover svg { transform: translateX(4px); }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const discountsBlob = document.getElementById('discountsBlob');
  const discountCols = document.querySelectorAll('#discountCols .discount-col');
  const section = document.getElementById('descuentos');

  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }

  if (!prefersReduced && section && discountsBlob) {
    const onScroll = () => {
      const r = section.getBoundingClientRect();
      // transform doesn't affect layout, so an unbounded offset can visually drift
      // a column into whatever sits after this section — clamp it so it never can.
      discountsBlob.style.transform = `translateY(${clamp(r.top * 0.05, -60, 60)}px)`;
      discountCols.forEach((col) => {
        const speed = parseFloat(col.dataset.speed) || 0;
        col.style.transform = `translateY(${clamp(r.top * speed, -40, 40)}px)`;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();
  }
</script>
