---
interface Option { value: string; label: string; }
interface Props { options: Option[]; targetId: string; }
const { options, targetId } = Astro.props;
---

<div class="filter-pills" data-filter-target={targetId}>
  {options.map((opt, i) => (
    <button class={`filter-pill${i === 0 ? ' active' : ''}`} data-filter={opt.value}>{opt.label}</button>
  ))}
</div>

<style>
  .filter-pills { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
  .filter-pill {
    font-family: var(--mono); font-size: 11.5px; text-transform: uppercase; letter-spacing: .04em;
    padding: 8px 16px; border-radius: 100px; border: 1px solid rgba(16,25,21,0.15); background: transparent;
    cursor: pointer; transition: all .2s ease; color: var(--ink); opacity: .6;
  }
  .filter-pill.active { background: var(--pop); border-color: var(--pop); color: var(--cream); opacity: 1; }
  .filter-pill:hover { opacity: 1; }
</style>
