---
interface Props {
  tag: string;
  name: string;
  price: string;
  url: string;
  categories: string[];
  image?: string | null;
}
const { tag, name, price, url, categories, image = null } = Astro.props;
---

<a href={url} target={url === '#' ? undefined : '_blank'} rel={url === '#' ? undefined : 'noopener noreferrer'} class:list={['p-feature', 'tilt-card', { 'has-image': !!image }]} data-category={categories.join(' ')}>
  {image && <img class="p-feature-img" src={image} alt="" loading="lazy" />}
  <div class="p-feature-body">
    <span class="tag">{tag}</span>
    <h3>{name}</h3>
    <div class="price">{price}</div>
    <span class="cta">Comprar ahora →</span>
  </div>
</a>

<style>
  .p-feature {
    display: block; grid-row: 1 / 3; border-radius: 24px; overflow: hidden; background: var(--forest); color: var(--cream);
    position: relative; min-height: 520px; display: flex; flex-direction: column; justify-content: flex-end;
    transition: transform .4s cubic-bezier(.16,1,.3,1);
  }
  .p-feature:hover { transform: translateY(-6px); }
  .p-feature::before {
    content: ""; position: absolute; inset: 0; z-index: 1;
    background: radial-gradient(circle at 75% 15%, rgba(193,96,47,0.35), transparent 55%), linear-gradient(160deg, var(--moss), var(--pine));
  }
  .p-feature.has-image::before {
    background: linear-gradient(0deg, rgba(16,25,21,0.92) 0%, rgba(16,25,21,0.35) 55%, rgba(16,25,21,0.15) 100%);
  }
  .p-feature-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .p-feature-body { position: relative; z-index: 2; padding: 34px; }
  .p-feature .tag {
    font-family: var(--mono); font-size: 11px; text-transform: uppercase; background: rgba(16,25,21,0.5); color: var(--pop);
    padding: 6px 14px; border-radius: 100px; border: 1px solid rgba(193,96,47,0.4);
  }
  .p-feature h3 { font-family: var(--display); font-weight: 700; font-size: 2rem; margin: 20px 0 8px; }
  .p-feature .price { font-family: var(--mono); color: var(--sage); font-size: 1.05rem; }
  .p-feature .cta { display: inline-flex; margin-top: 20px; font-family: var(--display); font-weight: 600; font-size: 15px; color: var(--pop); }
</style>
