---
interface Props {
  category: string;
  name: string;
  description: string;
  code: string;
  off: string;
  url: string;
  x?: string;
  d?: string;
}
const { category, name, description, code, off, url, x = '-40px', d = '0s' } = Astro.props;
const categoryLabel = category === 'camper' ? 'Camper' : 'Viaje';
---

<a
  href={url}
  target={url === '#' ? undefined : '_blank'}
  rel={url === '#' ? undefined : 'noopener noreferrer'}
  class="discount-card tilt-card slide-in"
  data-category={category}
  style={`--x:${x}; --d:${d}`}
>
  <span class="cat">{categoryLabel}</span>
  <h4>{name}</h4>
  <p>{description}</p>
  <div class="codeline"><span class="code">{code}</span><span class="off">{off}</span></div>
</a>

<style>
  .discount-card {
    display: block;
    background: var(--forest); color: var(--cream); border-radius: 20px; padding: 26px 26px 24px;
    position: relative; overflow: hidden; transition: transform .35s cubic-bezier(.16,1,.3,1);
  }
  .discount-card:hover { transform: translateY(-6px) !important; }
  .discount-card .cat { font-family: var(--mono); font-size: 10px; text-transform: uppercase; color: var(--sage); letter-spacing: .06em; }
  .discount-card h4 { font-family: var(--display); font-weight: 700; font-size: 1.5rem; margin: 12px 0 8px; }
  .discount-card p { font-size: .86rem; color: var(--mist); opacity: .75; line-height: 1.45; min-height: 38px; }
  .discount-card .codeline {
    margin-top: 18px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
    border-top: 1px dashed rgba(243,239,228,0.2); padding-top: 16px;
  }
  .discount-card .codeline .code { font-family: var(--mono); font-size: .9rem; color: var(--pop); font-weight: 500; }
  .discount-card .codeline .off { font-family: var(--display); font-weight: 700; font-size: 1.1rem; }
</style>
