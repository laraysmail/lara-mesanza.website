---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import videoHeaderPhoto from '../assets/site/header-diving.jpg';
import site from '../data/site.json';
import videosFallback from '../data/videos.json';
import playlistsData from '../data/playlists.json';
import { fetchLatestVideos, withPlaylistThumbnails } from '../lib/youtube.js';

const videos = await fetchLatestVideos(site.youtubeChannelId, 6, videosFallback);
const playlists = await withPlaylistThumbnails(playlistsData);
const channelUrl = site.youtubeChannelId ? `https://www.youtube.com/channel/${site.youtubeChannelId}` : '#';
const instagramUrl = 'https://www.instagram.com/lara_mesanza';
const tiktokUrl = 'https://www.tiktok.com/@laramesanza';
const xDirs = ['-40px', '40px', '-40px'];
---

<BaseLayout title="Vídeos — Lara Mesanza" description="Camperización, viajes low-cost y reformas, directo desde el canal de YouTube.">
  <section class="video-header" id="videoHeader">
    <Image src={videoHeaderPhoto} alt="Lara Mesanza haciendo submarinismo durante un viaje" class="video-header-photo" widths={[640, 960, 1400, 1920]} sizes="100vw" loading="eager" />
    <div class="video-header-bg"></div>
    <div class="video-header-grid"></div>
    <div class="video-header-content" id="videoHeaderContent">
      <span class="kicker">// consejos buenos, bonitos y baratos</span>
      <h1>Vídeos</h1>
      <p>Todo lo que subo al canal: instalaciones eléctricas paso a paso, reformas, y ahora, rumbo a Asia con nuestra peque.</p>
      <a class="channel-link" href={channelUrl} target={channelUrl === '#' ? undefined : '_blank'} rel={channelUrl === '#' ? undefined : 'noopener noreferrer'}>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a2.994 2.994 0 0 0-2.107-2.117C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.391.524A2.994 2.994 0 0 0 .502 6.186 31.16 31.16 0 0 0 0 12a31.16 31.16 0 0 0 .502 5.814 2.994 2.994 0 0 0 2.107 2.117c1.886.524 9.391.524 9.391.524s7.505 0 9.391-.524a2.994 2.994 0 0 0 2.107-2.117A31.16 31.16 0 0 0 24 12a31.16 31.16 0 0 0-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/></svg>
        Ver el canal completo en YouTube →
      </a>
    </div>
  </section>

  <section class="videos-body">
    <div class="wrap">
      <div class="video-grid">
        {videos.map((v, i) => (
          <VideoCard category={v.category} title={v.title} url={v.url} thumbnail={v.thumbnail} x={xDirs[i % 3]} d={`${(i % 3) * 0.08}s`} />
        ))}
      </div>
    </div>
  </section>

  <section class="playlists-body">
    <div class="wrap reveal">
      <span class="kicker">// por tema</span>
      <h2>Playlists</h2>
      <div class="video-grid">
        {playlists.map((p, i) => (
          <VideoCard category={p.category} title={p.title} url={p.url} thumbnail={p.thumbnail} x={xDirs[i % 3]} d={`${(i % 3) * 0.08}s`} />
        ))}
      </div>
    </div>
  </section>

  <section class="social-body">
    <div class="wrap reveal">
      <span class="kicker">// sígueme también aquí</span>
      <h2>El resto, en Instagram y TikTok</h2>
      <div class="social-grid">
        <a href={instagramUrl} class="social-card instagram" target="_blank" rel="noopener noreferrer">
          <div class="social-card-bg"></div>
          <div class="social-card-body">
            <div class="social-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></div>
            <h3>Sígueme en Instagram</h3>
            <p>Historias, detrás de cámaras y el día a día que no sale en YouTube.</p>
            <span class="social-cta">Seguir en Instagram →</span>
          </div>
        </a>
        <a href={tiktokUrl} class="social-card tiktok" target="_blank" rel="noopener noreferrer">
          <div class="social-card-bg"></div>
          <div class="social-card-body">
            <div class="social-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2 1.7 3.4 4 3.6v3c-1.5 0-2.8-.4-4-1.2v6.4a5.8 5.8 0 11-5-5.7v3.1a2.7 2.7 0 102.2 2.6V3h2.8z"/></svg></div>
            <h3>Sígueme en TikTok</h3>
            <p>Lo más rápido y directo, para cuando no tienes ni cinco minutos.</p>
            <span class="social-cta">Seguir en TikTok →</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .video-header {
    position: relative; height: 55vh; min-height: 420px; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  .video-header-photo {
    position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; object-fit: cover;
    object-position: center 25%; filter: saturate(0.9) brightness(0.6);
  }
  .video-header-bg {
    position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(120deg, rgba(60,92,77,0.75), rgba(16,25,21,0.55) 40%, rgba(30,47,39,0.75) 70%, var(--pine));
    background-size: 300% 300%;
    animation: video-header-pan 14s ease-in-out infinite;
  }
  @keyframes video-header-pan { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  @media (prefers-reduced-motion: reduce) { .video-header-bg { animation: none; } }
  .video-header-grid {
    position: absolute; inset: 0; z-index: 1;
    background-image: linear-gradient(rgba(243,239,228,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(243,239,228,0.05) 1px, transparent 1px);
    background-size: 64px 64px; mask-image: radial-gradient(circle at center, black 40%, transparent 75%);
  }
  .video-header-content {
    position: relative; z-index: 3; text-align: center; padding: 0 32px; max-width: 680px;
    opacity: 0; transition: opacity .9s cubic-bezier(.16,1,.3,1) .1s;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) { .video-header-content { opacity: 1; transition: none; } }
  .video-header .kicker {
    font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--pop); display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 16px;
  }
  .video-header .kicker::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--pop); box-shadow: 0 0 10px var(--pop); }
  .video-header h1 {
    font-family: var(--display); font-weight: 800; letter-spacing: -.03em; line-height: 1;
    font-size: clamp(2.2rem, 5.5vw, 4rem); color: var(--cream);
  }
  .video-header p { margin: 16px auto 0; max-width: 440px; color: var(--mist); font-size: .98rem; line-height: 1.55; }

  .channel-link {
    margin-top: 22px; display: inline-flex; align-items: center; gap: 10px; background: var(--pop); color: var(--pine);
    font-family: var(--display); font-weight: 600; font-size: .88rem; padding: 12px 22px; border-radius: 100px;
    transition: background .25s ease;
  }
  .channel-link svg { width: 18px; height: 18px; }
  .channel-link:hover { background: #d97442; }

  .videos-body { padding: 60px 0 0; }
  .video-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  @media (max-width: 900px) { .video-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .video-grid { grid-template-columns: 1fr; } }

  .playlists-body { padding: 100px 0 0; }

  .social-body { padding: 100px 0 130px; }
  .social-grid { margin-top: 44px; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  @media (max-width: 760px) { .social-grid { grid-template-columns: 1fr; } }

  .social-card {
    position: relative; overflow: hidden; border-radius: 22px; min-height: 300px;
    display: flex; align-items: flex-end; transition: transform .35s cubic-bezier(.16,1,.3,1);
  }
  .social-card:hover { transform: translateY(-6px); }
  .social-card-bg { position: absolute; inset: 0; }
  .social-card.instagram .social-card-bg { background: radial-gradient(circle at 75% 20%, rgba(193,96,47,0.3), transparent 55%), linear-gradient(150deg, var(--moss), var(--pine)); }
  .social-card.tiktok .social-card-bg { background: radial-gradient(circle at 25% 25%, rgba(60,92,77,0.4), transparent 55%), linear-gradient(160deg, var(--forest), var(--pine)); }

  .social-card-body { position: relative; z-index: 1; padding: 32px; color: var(--cream); }
  .social-icon {
    width: 44px; height: 44px; border-radius: 50%; background: rgba(243,239,228,0.1); border: 1px solid rgba(243,239,228,0.25);
    display: flex; align-items: center; justify-content: center; margin-bottom: 18px;
  }
  .social-icon svg { width: 20px; height: 20px; }
  .social-card-body h3 { font-family: var(--display); font-weight: 700; font-size: 1.5rem; }
  .social-card-body p { margin-top: 10px; font-size: .92rem; opacity: .8; max-width: 320px; line-height: 1.5; }
  .social-cta { display: inline-block; margin-top: 18px; font-family: var(--display); font-weight: 600; font-size: .85rem; color: var(--pop); }
</style>

<script>
  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const header = document.getElementById('videoHeader');
  const content = document.getElementById('videoHeaderContent');

  if (prefersReduced) {
    if (content) content.style.opacity = '1';
  } else if (header && content) {
    const onScroll = () => {
      const r = header.getBoundingClientRect();

      // same shrink-and-fade-as-you-scroll-away formula as the homepage's pinned hero
      // (src/scripts/home-motion.js) — this section isn't pinned, so "progress" is scaled
      // against its own height instead of (height - viewport), but the feel matches.
      const progress = clamp(-r.top / r.height, 0, 1);
      const scale = 1 - progress * 0.2;
      content.style.transform = `scale(${scale}) translateY(${progress * -40}px)`;
      content.style.opacity = String(1 - progress * 1.1);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    // delayed one frame so the browser paints the starting opacity:0 first —
    // otherwise this first update and the CSS base state collapse into one
    // paint and the fade-in transition never has anything to animate from.
    requestAnimationFrame(onScroll);
  }
</script>
