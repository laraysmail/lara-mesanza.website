---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import coverPhoto from '../assets/site/checklist-mochila.jpg';
import { MOCHILA_LAUNCH, mochilaLaunched } from '../data/launch.js';

const payhipUrl = 'https://payhip.com/b/tkgcR';
const payhipProduct = payhipUrl.split('/').pop();
const intro = 'Qué llevar en la mochila para viajar, en una checklist interactiva para ir marcando. Nuestra lista real, pensada sobre todo para calor y clima tropical, con cosas para viajar con bebé.';
const title = 'Checklist mochila para viajar: qué llevar (gratis)';
const description = 'Checklist gratis de mochila para viajar: qué llevar en clima cálido y tropical, con nuestra lista real y cosas para bebé. Interactiva.';
const pageURL = new URL('/checklist-mochila', Astro.site).toString();
---

<BaseLayout title={title} description={description} needsPayhip={true}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Checklist mochila gratuito',
    description,
    url: pageURL,
    offers: { '@type': 'Offer', url: payhipUrl, priceCurrency: 'EUR', price: '0', availability: 'https://schema.org/InStock' },
  })} />

  <div id="mochila-gate" data-launch={MOCHILA_LAUNCH} data-launch-redirect="/tienda" hidden={!mochilaLaunched()}>
    <PageHeader kicker="// checklist gratuita" description={intro}>
      <Fragment slot="title">Checklist <span>mochila</span> gratuito</Fragment>
    </PageHeader>

    <section class="checklist-detail">
      <div class="wrap detail-grid reveal">
        <div class="detail-visual">
          <Image src={coverPhoto} alt="Lara, Smaïl y su peque en el aeropuerto con las mochilas, a punto de salir de viaje" widths={[500, 800, 1100]} sizes="(max-width: 860px) 100vw, 50vw" format="webp" quality={80} loading="eager" />
        </div>
        <div class="detail-body">
          <span class="tag">Gratis · Checklist interactiva</span>
          <h2>Qué llevar en la mochila: nuestra lista real</h2>
          <ul>
            <li>Nuestra lista real como ejemplo: adáptala a tu ruta, tu clima y a quién viaje contigo</li>
            <li>6 reglas para decidir qué entra en la mochila y qué se queda en casa</li>
            <li>Con cosas para viajar con bebé, y útil igual si viajas sin él</li>
            <li>Interactiva: marca lo que llevas y añade tus propios ítems</li>
          </ul>
          <p class="outro">Descárgala gratis: solo te pedirá tu email para enviártela.</p>
          <a class="buy-btn payhip-buy-button" href={payhipUrl} data-product={payhipProduct} target="_blank" rel="noopener noreferrer">Descargar gratis →</a>

          <p class="format-note">📄 Es un archivo interactivo que se abre en cualquier navegador (Chrome, Safari...), no un PDF. Guárdalo o añádelo a la pantalla de inicio de tu móvil para tenerlo siempre a mano.</p>

          <a class="back-link" href="/tienda">← Volver a la tienda</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .checklist-detail { padding: 70px 0 120px; }
  .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  @media (max-width: 860px) { .detail-grid { grid-template-columns: 1fr; } }
  .detail-visual { aspect-ratio: 4/3; border-radius: 24px; overflow: hidden; background: linear-gradient(150deg, var(--moss), var(--pine)); }
  .detail-visual img { width: 100%; height: 100%; object-fit: cover; }
  .detail-body .tag { font-family: var(--mono); font-size: 11px; text-transform: uppercase; color: var(--popd); background: rgba(193,96,47,0.1); padding: 6px 14px; border-radius: 100px; display: inline-block; }
  .detail-body h2 { font-family: var(--display); font-weight: 700; font-size: clamp(1.7rem, 3.2vw, 2.3rem); margin: 18px 0 8px; letter-spacing: -.015em; }
  .detail-body ul { margin-top: 22px; display: flex; flex-direction: column; gap: 12px; }
  .detail-body li { font-size: .96rem; line-height: 1.55; color: var(--forest); opacity: .85; display: flex; gap: 10px; align-items: flex-start; }
  .detail-body li::before { content: "—"; color: var(--popd); flex-shrink: 0; }
  .detail-body .outro { margin-top: 22px; font-size: .96rem; line-height: 1.6; opacity: .8; max-width: 480px; }
  .buy-btn {
    margin-top: 30px; display: inline-flex; align-items: center; gap: 8px; background: var(--pop); color: var(--pine);
    font-family: var(--display); font-weight: 600; font-size: 14.5px; padding: 15px 28px; border-radius: 100px;
    transition: background .25s ease, transform .25s ease;
  }
  .buy-btn:hover { background: #d97442; transform: translateY(-2px); }
  .buy-btn.payhip-buy-button, .buy-btn.payhip-styled-button, .buy-btn.payhip-green-styled-button {
    background: var(--pop) !important; border: none !important; border-radius: 100px !important; color: var(--pine) !important;
    font-family: var(--display) !important; font-weight: 600 !important; font-size: 14.5px !important; padding: 15px 28px !important;
  }
  .buy-btn.payhip-buy-button:hover { background: #d97442 !important; }
  .format-note { margin-top: 18px; font-size: .85rem; line-height: 1.5; opacity: .65; max-width: 420px; }
  .back-link { display: block; margin-top: 18px; font-family: var(--display); font-weight: 600; font-size: 13.5px; color: var(--popd); opacity: .8; }
  .back-link:hover { opacity: 1; }
</style>
