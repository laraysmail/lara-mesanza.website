---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AmbientBlob from '../components/AmbientBlob.astro';
import ServiceCard from '../components/ServiceCard.astro';
import services from '../data/services.json';
import asesoramientoElectrico from '../assets/pages/asesoramiento-electrico.jpeg';

// TODO: swap for the real Google Business Profile review link once it exists
const googleReviewsUrl = '#';
---

<BaseLayout title="Asesoramiento eléctrico camper — Lara Mesanza" description="Smaïl diseña tu diagrama eléctrico camper a medida: tu vehículo, tu presupuesto, tu consumo real. Más de 20 asesoramientos, desde 220 € + IVA.">
  <PageHeader
    kicker="// para cuando quieres ayuda de verdad"
    description="El sistema eléctrico es lo que más miedo da de camperizar. Smaïl lleva más de 20 asesoramientos ayudando a gente sin experiencia previa a instalar el suyo con cabeza."
  >
    <Fragment slot="title">Asesoramiento</Fragment>
  </PageHeader>

  <section class="asesoramiento-body">
    <AmbientBlob size={380} top="-6%" left="-8%" color="rgba(60,92,77,0.16)" speed={-0.05} />
    <div class="wrap services-list">
      {services.map((s) => (
        <ServiceCard
          badge={s.badge}
          title={s.title}
          description={s.description}
          bullets={s.bullets}
          price={s.price}
          ctaLabel={s.ctaLabel}
          ctaHref={s.ctaHref}
          image={asesoramientoElectrico}
        />
      ))}
    </div>
  </section>

  <section class="reviews-body">
    <div class="wrap reveal">
      <span class="kicker">// lo que dicen quienes ya lo han hecho</span>
      <h2>100% clientes felices</h2>
      <div class="reviews-grid">
        <div class="review-card">
          <div class="stars">★★★★★</div>
          <p>"Nosotros contratamos este servicio de asesoramiento para nuestra furgoneta y fue una de las mejores decisiones, así que 100% se lo recomiendo a todos los que lean este comentario. Gracias Smaïl y Lara, nos ayudasteis muchísimo."</p>
          <span class="author">Sara Servan</span>
        </div>
        <div class="review-card">
          <div class="stars">★★★★★</div>
          <p>"Me puse en contacto con ellos para saber si me asesorarían para una pequeña casa de campo aislada y fue todo fantástico. Se preocupan muchísimo de que lo comprendas todo, te mandan muchísima información y, en su línea, nada caros. Repetiré si me lío en otra."</p>
          <span class="author">Isabel López</span>
        </div>
      </div>
      <a
        class="google-reviews-link"
        href={googleReviewsUrl}
        target={googleReviewsUrl === '#' ? undefined : '_blank'}
        rel={googleReviewsUrl === '#' ? undefined : 'noopener noreferrer'}
      >
        <svg viewBox="0 0 24 24" width="18" height="18"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.85A11 11 0 0012 23z"/><path fill="#FBBC05" d="M5.84 14.09A6.6 6.6 0 015.5 12c0-.73.12-1.43.34-2.09V7.06H2.18A11 11 0 001 12c0 1.77.42 3.45 1.18 4.94l3.66-2.85z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 00-9.82 6.06l3.66 2.85C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
        Ver reseñas en Google →
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .asesoramiento-body { padding: 80px 0 60px; position: relative; overflow: hidden; }
  .services-list { display: flex; flex-direction: column; gap: 24px; }

  .reviews-body { padding: 60px 0 120px; }
  .reviews-body .kicker {
    font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--popd);
    display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
  }
  .reviews-body .kicker::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--pop); box-shadow: 0 0 10px var(--pop); }
  .reviews-body h2 { font-family: var(--display); font-weight: 700; font-size: clamp(1.6rem, 3.4vw, 2.2rem); letter-spacing: -.015em; }
  .reviews-grid { margin-top: 36px; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  @media (max-width: 760px) { .reviews-grid { grid-template-columns: 1fr; } }
  .review-card { background: var(--forest); color: var(--cream); border-radius: 22px; padding: 32px; }
  .review-card .stars { color: var(--pop); letter-spacing: .1em; font-size: .95rem; }
  .review-card p { margin-top: 16px; font-size: .95rem; line-height: 1.6; color: var(--mist); }
  .review-card .author { display: block; margin-top: 18px; font-family: var(--display); font-weight: 600; font-size: .88rem; color: var(--sage); }

  .google-reviews-link {
    margin-top: 32px; display: inline-flex; align-items: center; gap: 10px; background: var(--forest); color: var(--cream);
    font-family: var(--display); font-weight: 600; font-size: .88rem; padding: 13px 24px; border-radius: 100px;
    border: 1px solid rgba(28,53,43,0.16); transition: transform .25s cubic-bezier(.16,1,.3,1), border-color .25s ease;
  }
  .google-reviews-link:hover { transform: translateY(-2px); border-color: var(--pop); }
</style>
