---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import services from '../data/services.json';
---

<BaseLayout title="Asesoramiento — Lara Mesanza" description="Smaïl diseña tu sistema eléctrico a medida. Tu furgo, tu presupuesto, tu consumo real, desde 200 €.">
  <PageHeader
    kicker="// para cuando quieres ayuda de verdad"
    description="Servicios de consultoría, diseñados a partir de lo que hemos aprendido en 5 proyectos DIY propios."
  >
    <Fragment slot="title">Asesoramiento</Fragment>
  </PageHeader>

  <section class="asesoramiento-body">
    <div class="wrap services-list">
      {services.map((s) => (
        <ServiceCard
          badge={s.badge}
          title={s.title}
          description={s.description}
          bullets={s.bullets}
          price={s.price}
          ctaLabel={s.ctaLabel}
          ctaHref={s.ctaHref}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .asesoramiento-body { padding: 80px 0 120px; }
  .services-list { display: flex; flex-direction: column; gap: 24px; }
</style>
